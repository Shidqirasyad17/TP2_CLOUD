
pipeline {
    agent any
    environment {
        DOCKER_USER = "sidra17" 
        GIT_REPO_URL = "https://github.com/Shidqirasyad17/TP2_CLOUD.git"
    }
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: "${GIT_REPO_URL}"
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-login', passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                    sh "docker build -t ${USER}/gudang-backend:latest ./backend"
                    sh "docker build -t ${USER}/gudang-frontend:latest ./frontend"
                    
                    sh "echo ${PASS} | docker login -u ${USER} --password-stdin"
                    sh "docker push ${USER}/gudang-backend:latest"
                    sh "docker push ${USER}/gudang-frontend:latest"
                }
            }
        }
        stage('Deploy ke Azure AKS') {
            steps {
                withKubeConfig([credentialsId: 'aks-config']) {
                    sh "kubectl apply -f gudang-k8s.yaml"
                    sh "kubectl rollout restart deployment backend-gudang"
                    sh "kubectl rollout restart deployment frontend-gudang"
                }
            }
        }
    }
}

